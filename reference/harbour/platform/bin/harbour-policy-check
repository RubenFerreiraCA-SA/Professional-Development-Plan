#!/usr/bin/env bash
# Offline Kyverno apply for required PR checks. Pin CLI v1.13.4.
# G1-03: mandatory fixtures; per-applicable-resource coverage inventory.
set -euo pipefail
NAME="${1:?service}"
POLICY="platform/policy/harbour-baseline.yaml"
FIXDIR="platform/policy/fixtures"
KYVERNO_VERSION="${KYVERNO_VERSION:-1.13.4}"
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT_ROOT="$(cd "$BIN_DIR/../.." && pwd)"
FIXTURE_SRC="${SCRIPT_ROOT}/tests/fixtures"
export PYTHONPATH="${BIN_DIR}${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p "$FIXDIR" /tmp/harbour-policy
command -v kyverno >/dev/null || {
  echo "Install kyverno CLI ${KYVERNO_VERSION} (no cluster needed for apply --resource)"; exit 1; }
kubectl kustomize "deploy/$NAME/overlays/staging" > /tmp/harbour-policy/rendered.yaml

run_kyverno_report() {
  local resource="$1" out="$2" err="$3" rc
  if kyverno apply "$POLICY" --resource "$resource" --policy-report >"$out" 2>"$err"; then
    rc=0
  else
    rc=$?
  fi
  printf '%s' "$rc"
}

APPLY_RC="$(run_kyverno_report /tmp/harbour-policy/rendered.yaml \
  /tmp/harbour-policy/report.yaml /tmp/harbour-policy/apply.err)"
python3 - "$APPLY_RC" <<'PY'
import sys
from pathlib import Path
from kyverno_deny import load_report, assert_expected_passes, inventory_from_rendered
apply_rc = int(sys.argv[1])
raw = Path("/tmp/harbour-policy/report.yaml").read_text()
rendered = Path("/tmp/harbour-policy/rendered.yaml").read_text()
try:
    rep = load_report(raw)
except ValueError as e:
    print(f"FAIL: {e}; see apply.err"); sys.exit(1)
expected_resources = inventory_from_rendered(rendered)
if not expected_resources:
    print("FAIL: no applicable resources in rendered overlay"); sys.exit(1)
assert_expected_passes(rep, apply_rc, expected_resources=expected_resources)
print(f"OK: offline PolicyReport — rules passed for resources={expected_resources}")
PY

must_deny_rule() {
  local f="$1" rule="$2" rc
  [ -f "$f" ] || { echo "FAIL: missing mandatory fixture $f"; exit 1; }
  rc="$(run_kyverno_report "$f" /tmp/harbour-policy/neg.yaml /tmp/harbour-policy/neg.err)"
  python3 - "$rule" "$rc" <<'PY'
import sys
from pathlib import Path
from kyverno_deny import load_report, denial_verdict, outcomes
want, apply_rc = sys.argv[1], int(sys.argv[2])
raw = Path("/tmp/harbour-policy/neg.yaml").read_text()
err = Path("/tmp/harbour-policy/neg.err").read_text()
try:
    rep = load_report(raw)
except ValueError as e:
    print(f"FAIL: tool error ({e}), not a policy denial:", err[:400]); sys.exit(1)
verdict = denial_verdict(want, rep)
matched = outcomes(rep)[:12]
if verdict == "reject-mixed":
    print(f"FAIL: rule {want} has non-fail outcomes (mixed); saw={matched}")
    sys.exit(1)
if verdict != "accept":
    print(f"FAIL: did not observe rule {want} result=fail; saw={matched} rc={apply_rc}")
    sys.exit(1)
print(f"OK: rule {want} denied fixture with clean result=fail (kyverno_rc={apply_rc})")
PY
}

MANDATORY_FIXTURES=(
  bad-mutable-tag.yaml
  bad-no-memory-limit.yaml
  bad-init-mutable-tag.yaml
  bad-ephemeral-privileged.yaml
  good-ephemeral.yaml
)
[ -d "$FIXTURE_SRC" ] || { echo "FAIL: missing fixture source $FIXTURE_SRC"; exit 1; }
for f in "${MANDATORY_FIXTURES[@]}"; do
  [ -f "$FIXTURE_SRC/$f" ] || { echo "FAIL: missing mandatory fixture $FIXTURE_SRC/$f"; exit 1; }
  cp -f "$FIXTURE_SRC/$f" "$FIXDIR/$f"
done

GOOD_RC="$(run_kyverno_report "$FIXDIR/good-ephemeral.yaml" \
  /tmp/harbour-policy/good-ephem.yaml /tmp/harbour-policy/good-ephem.err)"
python3 - "$GOOD_RC" "$FIXDIR/good-ephemeral.yaml" <<'PY'
import sys
from pathlib import Path
from kyverno_deny import load_report, assert_expected_passes, inventory_from_rendered
rep = load_report(Path("/tmp/harbour-policy/good-ephem.yaml").read_text())
resources = inventory_from_rendered(Path(sys.argv[2]).read_text())
assert_expected_passes(rep, int(sys.argv[1]), expected_resources=resources or None)
print("OK: good-ephemeral fixture — all expected rules passed")
PY

EXECUTED=0
must_deny_rule "$FIXDIR/bad-mutable-tag.yaml" "require-image-digest"; EXECUTED=$((EXECUTED+1))
must_deny_rule "$FIXDIR/bad-no-memory-limit.yaml" "require-nonroot-memory-limit"; EXECUTED=$((EXECUTED+1))
must_deny_rule "$FIXDIR/bad-init-mutable-tag.yaml" "require-image-digest"; EXECUTED=$((EXECUTED+1))
must_deny_rule "$FIXDIR/bad-ephemeral-privileged.yaml" "require-ephemeral-no-privilege"; EXECUTED=$((EXECUTED+1))
echo "OK: offline policy check for $NAME (negative_fixtures_executed=$EXECUTED)"
