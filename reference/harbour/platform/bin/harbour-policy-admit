#!/usr/bin/env bash
# Lab/integration only — not the PR required check.
# Requires pullable digests via env (M-01):
#   HARBOUR_PULLABLE_DIGEST_IMG  e.g. nginx@sha256:...
#   HARBOUR_PULLABLE_DBG_IMG     e.g. busybox@sha256:...
set -euo pipefail
NS="${1:?namespace}"
DIGEST_IMG="${HARBOUR_PULLABLE_DIGEST_IMG:?set HARBOUR_PULLABLE_DIGEST_IMG to a pullable image@sha256:...}"
DBG_IMG="${HARBOUR_PULLABLE_DBG_IMG:?set HARBOUR_PULLABLE_DBG_IMG to a pullable debug image@sha256:...}"

# Expected Kyverno denial substrings (document in evidence).
EXPECT_DIGEST_DENY="${HARBOUR_EXPECT_DIGEST_DENY:-require-image-digest|harbour-baseline|digest}"
EXPECT_EPHEM_DENY="${HARBOUR_EXPECT_EPHEM_DENY:-require-ephemeral-no-privilege|harbour-baseline|privilege}"

kubectl -n "$NS" delete pod policy-probe-tag policy-probe-ephem --ignore-not-found --wait=false
set +e
kubectl -n "$NS" apply -f - <<EOF 2>/tmp/adm-kyverno.txt
apiVersion: v1
kind: Pod
metadata: {name: policy-probe-tag}
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext: {runAsNonRoot: true, runAsUser: 10001, seccompProfile: {type: RuntimeDefault}}
  containers:
    - name: c
      image: nginx:latest
      resources: {requests: {cpu: 10m, memory: 16Mi}, limits: {memory: 32Mi}}
      securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
EOF
rc=$?; set -e
[ "$rc" -ne 0 ] || { echo "FAIL: admission accepted nginx:latest"; exit 1; }
grep -qiE "$EXPECT_DIGEST_DENY" /tmp/adm-kyverno.txt \
  || { echo "FAIL: rejection was not Kyverno digest rule (got: $(cat /tmp/adm-kyverno.txt))"; exit 1; }
echo "OK: Kyverno admission denied mutable tag (distinct from PSA)"
echo "Expected denial pattern: $EXPECT_DIGEST_DENY"

# Live ephemeralcontainers — Ready wait uses the pullable digest only.
kubectl -n "$NS" apply -f - <<EOF
apiVersion: v1
kind: Pod
metadata: {name: policy-probe-ephem}
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext: {runAsNonRoot: true, runAsUser: 10001, seccompProfile: {type: RuntimeDefault}}
  containers:
    - name: c
      image: ${DIGEST_IMG}
      command: ["sleep", "3600"]
      resources: {requests: {cpu: 10m, memory: 16Mi}, limits: {memory: 32Mi}}
      securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
EOF
kubectl -n "$NS" wait --for=condition=Ready pod/policy-probe-ephem --timeout=120s
set +e
kubectl -n "$NS" patch pod policy-probe-ephem --subresource=ephemeralcontainers --type=json \
  -p="[
    {\"op\":\"add\",\"path\":\"/spec/ephemeralContainers\",\"value\":[
      {\"name\":\"dbg\",\"image\":\"${DBG_IMG}\",\"command\":[\"sleep\",\"60\"],
       \"securityContext\":{\"allowPrivilegeEscalation\":true}}
    ]}
  ]" 2>/tmp/adm-ephem.txt
ephem_rc=$?; set -e
[ "$ephem_rc" -ne 0 ] || { echo "FAIL: ephemeralcontainers accepted privileged debug"; exit 1; }
grep -qiE "$EXPECT_EPHEM_DENY" /tmp/adm-ephem.txt \
  || { echo "FAIL: rejection was not ephemeral privilege rule (got: $(cat /tmp/adm-ephem.txt))"; exit 1; }
echo "OK: Kyverno denied privileged pods/ephemeralcontainers update"
echo "Expected denial pattern: $EXPECT_EPHEM_DENY"
kubectl -n "$NS" delete pod policy-probe-ephem --ignore-not-found --wait=false
